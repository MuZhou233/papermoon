+/** Inclusive tool schema supplied through the ordinary registry. */
+export const inject = ['tools']
+export function apply(ctx) {
+  ctx.effect(() => ctx.tools.register({
+    name: 'echo_number', description: 'Return the supplied number.',
+    parameters: { type: 'object', properties: { value: { anyOf: [{ type: 'number' }, { type: 'integer' }] } }, required: ['value'], additionalProperties: false },
+    output: { schema: { anyOf: [{ type: 'number' }, { type: 'integer' }] }, render: (_args, value) => [{ type: 'text', text: String(value) }] },
+    execute: args => args.value,
+  }))
+}
