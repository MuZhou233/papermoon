+import { expect, it } from 'vitest'
+import { Session, SessionId, SessionSeq, foldSurface, selectHistory } from '../src/index.ts'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+const input = (session: Session, text: string) => session.append('user/message', createUserMessage({ content: [{ type: 'text', text }], source: { kind: 'user' } }), { surfaceOp: 'append' })
+it('selects noncontiguous ancestry without changing prior requests or raw coordinates', async () => {
+  const session = Session.create(SessionId('tree'))
+  input(session, 'A'); input(session, 'B')
+  session.append('history/selected', { version: 1, ranges: [{ start: SessionSeq(0), end: SessionSeq(0) }], metadata: {} })
+  input(session, 'C')
+  const read = await session.readHistory()
+  expect(read.events.map(event => event.seq)).toEqual([0, 3])
+  expect(session.deriveMessages().map(message => message.content)).toEqual([[{ type: 'text', text: 'A' }], [{ type: 'text', text: 'C' }]])
+  session.append('history/selected', { version: 2, ranges: [{ start: SessionSeq(0), end: SessionSeq(1) }], metadata: {} })
+  expect(read.events.map(event => event.seq)).toEqual([0, 3])
+  expect(session.surface.nodes).toEqual([0, 1])
+  expect(session.seq).toBe(5)
+})
+it('rejects future, overlapping, out-of-order and stale selections before append', () => {
+  const session = Session.create(SessionId('invalid')); input(session, 'a'); input(session, 'b')
+  for (const ranges of [[{ start: 0, end: 2 }], [{ start: -1, end: 0 }], [{ start: 1, end: 1 }, { start: 0, end: 0 }]]) {
+    expect(() => session.append('history/selected', { version: 1, ranges: ranges.map(range => ({ start: SessionSeq(range.start), end: SessionSeq(range.end) })), metadata: {} })).toThrow()
+    expect(session.seq).toBe(2)
+  }
+  expect(() => session.append('history/selected', { version: 2, ranges: [], metadata: {} })).toThrow(/version/)
+})
+it('reconstructs an earlier branch from a full raw prefix', () => {
+  const events = [
+    { type: 'user/message', seq: 0, time: 1, surfaceOp: 'append', data: createUserMessage({ content: [{ type: 'text', text: 'A' }], source: { kind: 'user' } }) },
+    { type: 'history/selected', seq: 1, time: 1, data: { version: 1, ranges: [], metadata: {} } },
+    { type: 'user/message', seq: 2, time: 1, surfaceOp: 'append', data: createUserMessage({ content: [{ type: 'text', text: 'B' }], source: { kind: 'user' } }) },
+  ] as unknown as import('../src/types.ts').SessionEvent[]
+  expect(foldSurface(events).nodes).toEqual([2])
+  expect(foldSurface(events.slice(0, 1)).nodes).toEqual([0])
+  expect(selectHistory(events).map(event => event.seq)).toEqual([2])
+})
