+/** Durable request-local message selection, independent of the transcript surface.
+ * @module @deepseek-ai/dsh-session/request-messages
+ */
+import type { Message } from '@deepseek-ai/dsh-llm'
+import type { SessionEvent, SessionSeq } from './types.ts'
+import { deriveEventMessage, foldSurface } from './surface.ts'
+
+/** One original event reference or an inline producer-authored message. */
+export type RequestMessagePart = { eventSeq: SessionSeq } | { message: Message; name?: string }
+
+/** Resolve one durable request, retaining original message and replay identities.
+ * @param events - contiguous immutable log, including the request record.
+ * @param seq - request/messages event, or undefined for the normal current surface.
+ * @returns ordered message objects; referenced history is not modified.
+ * @throws when a request refers forward, cites a non-message, or has an invalid base.
+ */
+export function resolveRequestMessages(events: readonly SessionEvent[], seq?: SessionSeq): Message[] {
+  if (seq === undefined) return foldSurface(events).nodes.flatMap((index) => {
+    const event = events[index]
+    if (!event) throw new Error('request message source is unavailable')
