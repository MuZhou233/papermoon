+/**
+ * Validate installed extensions before deriving a frozen-validator input.
+ * Original records are fully validated first and remain the restored result.
+ * @param artifact - current logical artifact; never mutated.
+ * @returns same-coordinate relationship view for the released validator only.
+ */
+export function releasedValidationView(artifact: SessionFormatArtifact): SessionFormatArtifact {
+  const changed = new Set<number>()
+  const selectedHistory = artifact.events.some(event => event.type === 'history/selected')
+  if (selectedHistory) validateInstalledCurrentSessionArtifact(artifact)
+  const messageView = (value: SessionFormatJsonValue): SessionFormatJsonValue => {
+    if (!isSessionFormatJsonObject(value) || !isSessionFormatJsonObject(value['source'])) return value
+    const source = value['source']
+    if (source['kind'] !== 'user' || !Object.hasOwn(source, 'admission')) return value
+    if (!isSessionFormatJsonObject(source['admission'])) throw new Error('user admission metadata must be a JSON object')
+    const { admission: _admission, ...released } = source
+    return { ...value, source: released }
+  }
+  let step: { turn: unknown; step: unknown } | undefined
+  const events = artifact.events.map((event, index) => {
+    if (event.type === 'step/start' && isSessionFormatJsonObject(event.data)) {
+      step = { turn: event.data['turn'], step: event.data['step'] }
+    } else if (event.type === 'step/end' || event.type === 'turn/end') step = undefined
+    if (selectedHistory && event.type === 'system/message') {
+      if (!isSessionFormatJsonObject(event.data) || step === undefined
+        || step.turn !== event.data['turn'] || step.step !== event.data['step']) {
+        throw new Error('system/message does not match an open step')
+      }
+      changed.add(index)
+      return { type: 'session/configuration', seq: event.seq, time: event.time,
+        data: { key: 'installed-system-placement', value: null } }
+    }
+    if (selectedHistory && typeof event['surfaceOp'] === 'object') {
+      // Installed surface validation owns branch-sensitive replacement relationships.
+      // The released validator still checks every original request and tool lifecycle.
+      changed.add(index)
+      return { type: 'session/configuration', seq: event.seq, time: event.time,
+        data: { key: 'installed-surface-validation', value: null } }
+    }
+    if (event.type === 'context/message') {
+      changed.add(index)
+      const data = event.data
+      if (!isSessionFormatJsonObject(data) || !isSessionFormatJsonObject(data['message'])) throw new Error('authored context requires a message object')
+      return { ...event, type: 'user/message', data: messageView({ ...data['message'], role: 'user' }) }
+    }
+    if (event.type === 'user/message') {
+      const data = messageView(event.data)
+      if (data !== event.data) changed.add(index)
+      return { ...event, data }
+    }
