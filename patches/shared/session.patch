@@ -0,0 +1,31 @@
+import { expect, it } from 'vitest'
+import { Session, SessionId, SessionSeq, resolveRequestMessages } from '../src/index.ts'
+import { createUserMessage } from '@deepseek-ai/dsh-llm'
+it('keeps request selection separate from full history and restores exact earlier requests', () => {
+  const session = Session.create(SessionId('request-selection'))
+  const input = (text: string) => session.append('user/message', createUserMessage({ content:[{ type:'text',text }],source:{ kind:'user' } }), { surfaceOp:'append' })
+  input('old');input('new')
+  const prompt = createUserMessage({ content:[{ type:'text',text:'tail {{literal}}' }],source:{ kind:'plugin',plugin:'fixture' } })
+  const first = session.append('request/messages',{ version:1,turn:1,step:1,messages:[{ eventSeq:SessionSeq(1) },{ message:prompt,name:'Tail' }] })
+  const base = session.deriveRequestMessages(first.seq)
+  expect(base.map(m=>m.content)).toEqual([[{ type:'text',text:'new' }],prompt.content])
+  expect(session.deriveMessages()).toHaveLength(2)
+  const reply=input('continued')
+  const second=session.append('request/messages',{ version:1,turn:1,step:2,base:first.seq,messages:[{ eventSeq:reply.seq }] })
+  expect(session.deriveRequestMessages(second.seq)).toEqual([...base,reply.data])
+  session.append('history/selected',{ version:1,ranges:[{ start:SessionSeq(0),end:SessionSeq(0) }],metadata:{} })
+  expect(session.deriveMessages()).toHaveLength(1)
+  expect(resolveRequestMessages(session.snapshotEvents(),first.seq)).toEqual(base)
+  const normal=session.append('request/messages',{ version:1,turn:2,step:1,messages:null })
+  expect(session.deriveRequestMessages(normal.seq)).toEqual([session.deriveMessages()[0]])
+})
+it('refuses forward references, non-message sources and invalid request bases', () => {
+  const session=Session.create(SessionId('bad-request'))
+  session.append('turn/start',{ turn:1 })
+  for(const messages of [[{ eventSeq:SessionSeq(0) }],[{ eventSeq:SessionSeq(999) }]]) {
+    const event=session.append('request/messages',{ version:1,turn:1,step:1,messages })
+    expect(()=>session.deriveRequestMessages(event.seq)).toThrow()
+  }
+  const event=session.append('request/messages',{ version:1,turn:1,step:1,base:SessionSeq(0),messages:[] })
+  expect(()=>session.deriveRequestMessages(event.seq)).toThrow(/invalid request/)
+})
