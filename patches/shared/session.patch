+    const row = { type: 'context/message', seq: 0, time: 1, surfaceOp: 'append', data: { groupId: 'accepted', index: 0, message: { ...user.data, content: [{ type: 'file', attachment: { attachmentId: 'sha256:' + 'ab'.repeat(32), name: 'input.txt', bytes: 3 } }] } } }
+    const reader = sessionFormatCatalog.createRestore(header, { recovery: 'strict', validation: 'current' })
+    reader.decodeRow(sessionFormatCatalog.encodeCurrentEvent(row))
+    expect(reader.finish().events).toEqual([row])
+  })
+  it('rejects invalid authored roles, source metadata and surface references before restoration', () => {
+    for (const changed of [
+      { ...context, data: { ...context.data, message: { ...context.data.message, role: 'system' } } },
+      { ...context, data: { ...context.data, index: -1 } },
+      { ...context, surfaceOp: { op: 'replace', startSeq: 10, endSeq: 10 } },
+      { ...context, data: { ...context.data, message: { ...context.data.message, source: { kind: 'model' } } } },
+    ]) expect(() => restore([system, changed])).toThrow()
+    expect(() => restore([system, context, { ...user, data: { ...user.data, source: { kind: 'user', admission: 'bad' } } }])).toThrow()
+  })
+})
+
+
+it('validates system placement on the selected path while preserving raw lifecycle checks', () => {
+  const session = Session.create(SessionId('selected-system'))
+  session.append('user/message', createUserMessage({ content: [{ type: 'text', text: 'Abandoned input' }], source: { kind: 'user' } }), { surfaceOp: 'append' })
+  session.append('history/selected', { version: 1, ranges: [], metadata: {} })
+  session.append('turn/start', { turn: 1 })
+  session.append('step/start', { turn: 1, step: 1 })
+  session.append('system/message', { turn: 1, step: 1, message: createSystemMessage('Selected prompt', 'fixture') }, { surfaceOp: 'append' })
+  const events = session.snapshotEvents()
+  const restore = (rows: readonly unknown[]) => {
+    const reader = sessionFormatCatalog.createRestore({ type: 'session', version: 3, id: 'selected-system', createdAt: 1, isSeeded: false, delegationDepth: 0 }, { recovery: 'strict', validation: 'current' })
+    rows.forEach((row) => { reader.decodeRow(row) })
+    return reader.finish()
+  }
+  expect(restore(events).events).toEqual(events)
+  const invalid = events.map(event => event.type === 'step/start'
+    ? { ...event, type: 'session/configuration', data: { key: 'missing-step', value: null } } : event)
+  expect(() => restore(invalid)).toThrow('system/message does not match an open step')
+})
