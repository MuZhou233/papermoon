+/** Durable request-local message selection, independent of the transcript surface.
+ * @module @deepseek-ai/dsh-session/request-messages
+ */
+import type { Message } from '@deepseek-ai/dsh-llm'
+import type { SessionEvent, SessionSeq } from './types.ts'
+import { deriveEventMessage, foldSurface, type SessionMessageProjection } from './surface.ts'
+
+/** One original event reference or an inline producer-authored message. */
+export type RequestMessagePart = { eventSeq: SessionSeq } | { message: Message; name?: string }
+
+/** Resolve one durable request, retaining original message and replay identities.
+ * @param events - contiguous immutable log, including the request record.
+ * @param seq - request/messages event, or undefined for the normal current surface.
+ * @param projections - installed pure message interpreters.
+ * @returns ordered message objects; referenced history is not modified.
+ * @throws when a request refers forward, cites a non-message, or has an invalid base.
+ */
+export function resolveRequestMessages(
+  events: readonly SessionEvent[], seq?: SessionSeq, projections: readonly SessionMessageProjection[] = [],
+): Message[] {
+  if (seq === undefined) {
+    const surface = foldSurface(events, projections)
+    return surface.nodes.flatMap((index) => {
+      const event = events[index]
+      if (!event) throw new Error('request message source is unavailable')
+      const message = deriveEventMessage(event, surface.projectedMessages)
+      return message === null ? [] : [message]
+    })
+  }
+  const projected = foldSurface(events.slice(0, seq), projections).projectedMessages
+  const seen = new Set<number>()
+  const segments: Message[][] = []
+  let cursor: SessionSeq | undefined = seq
+  while (cursor !== undefined) {
+    const event: SessionEvent | undefined = events[cursor]
+    if (!event || event.type !== 'request/messages' || seen.has(cursor)) throw new Error('invalid request message record')
+    seen.add(cursor)
+    const data: SessionEvent<'request/messages'>['data'] = event.data
+    const current = cursor
+    if (data.messages === null) {
+      const surface = foldSurface(events.slice(0, cursor), projections)
+      segments.push(surface.nodes.flatMap((index) => {
+        const source = events[index]
+        const message = source && deriveEventMessage(source, projected)
+        return message ? [message] : []
+      }))
+      break
+    }
+    const messages = data.messages.map((part) => {
+      if ('message' in part) return part.message
+      if (part.eventSeq >= current) throw new Error('request message reference must precede its request')
+      const source = events[part.eventSeq]
+      const message = source && deriveEventMessage(source, projected)
+      if (!message) throw new Error('request reference does not identify a message')
+      return message
+    })
+    segments.push(messages)
+    if (data.base !== undefined && data.base >= cursor) throw new Error('request base must precede its continuation')
+    cursor = data.base
+  }
+  return segments.reverse().flat()
+}
