+/** Browser-safe selection of execution records from an append-only Session log. */
+import type { SessionEvent, SessionHistoryRange } from './types.ts'
+
+/**
+ * Validate ordered references to records preceding a selection.
+ * @param ranges - inclusive ranges in execution order.
+ * @param before - exclusive upper sequence bound.
+ * @returns after asserting that every range contains valid earlier coordinates.
+ */
+export function validateHistoryRanges(ranges: unknown, before: number): asserts ranges is readonly SessionHistoryRange[] {
+  if (!Array.isArray(ranges)) throw new Error('history selection ranges must be an array')
+  let previous = -1
+  const values: readonly unknown[] = ranges
+  for (const value of values) {
+    if (!value || typeof value !== 'object' || !('start' in value) || !('end' in value)) {
+      throw new Error('history selection range must contain start and end coordinates')
+    }
+    const range = value
+    if (typeof range.start !== 'number' || typeof range.end !== 'number' || !Number.isSafeInteger(range.start) || !Number.isSafeInteger(range.end)
+      || range.start <= previous || range.end < range.start || range.end >= before) {
+      throw new Error('history selection ranges must be ordered, disjoint and precede their selection')
+    }
+    previous = range.end
+  }
+}
+
+/**
+ * Test a durable coordinate against ordered selected ranges.
+ * @param seq - raw event sequence.
+ * @param ranges - validated inclusive ranges.
+ * @returns whether the coordinate belongs to the selection.
+ */
+export function historyContains(seq: number, ranges: readonly SessionHistoryRange[]): boolean {
+  let low = 0, high = ranges.length
+  while (low < high) {
+    const mid = (low + high) >>> 1
+    const range = ranges[mid] as SessionHistoryRange
+    if (seq < range.start) high = mid
+    else if (seq > range.end) low = mid + 1
+    else return true
+  }
+  return false
+}
+
+/**
+ * Read the selected execution history at the end of a complete raw prefix.
+ * Selection records are control facts, never historical model input.
+ * @param events - raw records, including every selection up to the read position.
+ * @returns ancestry records followed by records appended since its selection.
+ */
+export function selectHistory<T extends { readonly seq: number; readonly type: string; readonly data: unknown }>(
+  events: readonly T[],
+): T[] {
+  const selection = events.findLast(event => event.type === 'history/selected')
+  if (!selection) return [...events]
+  const data = selection.data as SessionEvent<'history/selected'>['data']
+  validateHistoryRanges(data.ranges, selection.seq)
+  return events.filter(event => event.type !== 'history/selected'
+    && (event.seq > selection.seq || historyContains(event.seq, data.ranges)))
+}
+
+/**
+ * Read the most recent selection version; raw event identities never rewind.
+ * @param events - raw Session prefix.
+ * @returns zero before the first explicit selection.
+ */
+export function historyVersion(events: readonly SessionEvent[]): number {
+  return events.findLast(event => event.type === 'history/selected')?.data.version ?? 0
+}
