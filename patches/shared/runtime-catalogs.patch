diff --git a/scripts/gen-cordis-catalog-runtime.spec.ts b/scripts/gen-cordis-catalog-runtime.spec.ts
new file mode 100644
index 0000000000..9c2655989a
--- /dev/null
+++ b/scripts/gen-cordis-catalog-runtime.spec.ts
@@ -0,0 +1,96 @@
+/** Runtime catalog generation shares the full projection without maintaining its documentation. */
+import { readFileSync, writeFileSync } from 'node:fs'
+import type { PathOrFileDescriptor } from 'node:fs'
+import { resolve } from 'node:path'
+import { afterEach, beforeAll, beforeEach, describe, expect, it, vi } from 'vitest'
+import { projectCordisCatalog } from '@deepseek-ai/dsh-typert-generator'
+import { computeOutputs, CORDIS_CATALOG_POLICY, main } from './gen-cordis-catalog.ts'
+
+const files = vi.hoisted(() => new Map<string, string>())
+vi.mock('node:fs', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('node:fs')>()
+  return {
+    ...actual,
+    // Keep generator writes in memory; projection reads still use the real source tree.
+    readFileSync: vi.fn((
+      file: PathOrFileDescriptor,
+      options?: BufferEncoding | { encoding?: BufferEncoding | null; flag?: string } | null,
+    ) => {
+      const content = files.get(String(file))
+      if (content === undefined) return actual.readFileSync(file, options)
+      const encoding = typeof options === 'string' ? options : options?.encoding
+      return encoding ? content : Buffer.from(content)
+    }),
+    writeFileSync: vi.fn((file: PathOrFileDescriptor, content: string | NodeJS.ArrayBufferView) => {
+      const text = typeof content === 'string' ? content : Buffer.from(content.buffer, content.byteOffset, content.byteLength).toString()
+      files.set(String(file), text)
+    }),
+    mkdirSync: vi.fn(),
+  }
+})
+vi.mock('@deepseek-ai/dsh-typert-generator', async (importOriginal) => {
+  const actual = await importOriginal<typeof import('@deepseek-ai/dsh-typert-generator')>()
+  return { ...actual, projectCordisCatalog: vi.fn(actual.projectCordisCatalog) }
+})
+
+const root = resolve(import.meta.dirname, '..')
+const runtime = 'packages/extensions/tool-cordis/src/api-catalog.ts'
+const inherited = resolve(root, 'docs/cordis-api/inherited.md')
+let expected: string
+
+beforeAll(() => {
+  // Reuse one real type projection across I/O scenarios instead of rescanning each time.
+  const projection = projectCordisCatalog(root, CORDIS_CATALOG_POLICY)
+  vi.mocked(projectCordisCatalog).mockReturnValue(projection)
+  expected = projection.projector.renderRuntimeApi(projection.model)
+}, 60_000)
+
+beforeEach(() => {
+  files.clear()
+  vi.clearAllMocks()
+  vi.spyOn(console, 'log').mockImplementation(() => {})
+  vi.spyOn(console, 'error').mockImplementation(() => {})
+  vi.spyOn(process, 'exit').mockImplementation((code) => { throw new Error(`exit ${String(code)}`) })
+})
+
+afterEach(() => { vi.restoreAllMocks() })
+
+describe('runtime-only Cordis catalog', () => {
+  it('uses the same Host API as the default full projection', () => {
+    const full = computeOutputs()
+    expect(full.find(([path]) => path === runtime)).toEqual([runtime, expected])
+    expect(full.some(([path]) => path.startsWith('docs/'))).toBe(true)
+    expect(computeOutputs(true)).toEqual([[runtime, expected]])
+  }, 60_000)
+
+  it('generates only runtime code even when documentation is stale', () => {
+    files.set(resolve(root, runtime), 'stale runtime\n')
+    files.set(inherited, 'stale documentation\n')
+    main(['--runtime-only'])
+    expect(vi.mocked(writeFileSync).mock.calls.map(([path]) => path)).toEqual([resolve(root, runtime)])
+    expect(readFileSync(resolve(root, runtime), 'utf8')).toBe(expected)
+    expect(readFileSync(inherited, 'utf8')).toBe('stale documentation\n')
+  })
+
+  it('checks runtime freshness without writing or checking documentation', () => {
+    files.set(resolve(root, runtime), expected)
+    files.set(inherited, 'stale documentation\n')
+    expect(() => { main(['--runtime-only', '--check']) }).toThrow('exit 0')
+    expect(writeFileSync).not.toHaveBeenCalled()
+  })
+
+  it('rejects stale runtime output without replacing it', () => {
+    files.set(resolve(root, runtime), 'stale runtime\n')
+    expect(() => { main(['--check', '--runtime-only']) }).toThrow('exit 1')
+    expect(writeFileSync).not.toHaveBeenCalled()
+    expect(console.error).toHaveBeenCalledWith(expect.stringContaining('--runtime-only'))
+    expect(readFileSync(resolve(root, runtime), 'utf8')).toBe('stale runtime\n')
+  })
+
+  it('keeps documentation freshness in the default check', () => {
+    files.set(inherited, 'stale documentation\n')
+    expect(() => { main(['--check']) }).toThrow('exit 1')
+    expect(console.error).toHaveBeenCalledWith(expect.stringContaining('docs/cordis-api/inherited.md'))
+    expect(writeFileSync).not.toHaveBeenCalled()
+  }, 60_000)
+})
