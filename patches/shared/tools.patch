@@ -0,0 +1,9 @@
+/** Typed dictionary supplied through the ordinary registry. */
+export const inject = ['tools']
+export function apply(ctx) {
+  ctx.effect(() => ctx.tools.register({
+    ...{"name": "echo_dictionary", "description": "Return the supplied dictionary.", "parameters": {"type": "object", "properties": {"value": {"type": "object", "additionalProperties": {"type": "number"}}}, "required": ["value"], "additionalProperties": false}},
+    output: { schema: {"type": "object", "additionalProperties": {"type": "number"}}, render: (_args, value) => [{type:'text',text:JSON.stringify(value)}] },
+    execute: args => args.value,
+  }))
+}
