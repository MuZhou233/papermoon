+ * Returning undefined delegates to the ordinary surface. This does not edit history.
+ * @param payload.agent - requesting agent.
+ * @param payload.turn - current turn.
+ * @param payload.step - current step.
+ * @param payload.signal - cancellation before dispatch.
+ * @param next - delegated message selection.
+ * @mode waterfall
+ */
+'agent/request-messages'(this: Scoped<Agent>, payload: { agent: Agent; turn: number; step: number; signal: AbortSignal }, next: () => Promise<SessionSeq | undefined>): Promise<SessionSeq | undefined>
