+  /** Estimate one fully assembled request without reading or changing transcript state.
+   * @param messages - exact request messages, including preserved tool protocol blocks.
+   * @param header - effective model configuration and tool declarations.
+   * @returns fixed heuristic input tokens; provider usage remains separate.
+   */
+  estimateRequest(messages: readonly Message[], header?: EpochHeader): number {
+    return messages.reduce((sum, message) => sum + estimateMessage(message), 0) + estimateToolsTokens(header)
+  }
+
