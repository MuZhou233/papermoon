+it('estimates the selected request and tools without charging omitted transcript text', () => {
+  const service = meter()
+  const selected = [textMessage('selected input')]
+  expect(service.estimateRequest(selected)).toBe(service.estimateMessage(selected[0]!))
+  expect(service.estimateRequest([...selected, textMessage('omitted history'.repeat(100))])).toBeGreaterThan(service.estimateRequest(selected))
