diff --git a/packages/client/ui-conversation/src/client/page-policy.ts b/packages/client/ui-conversation/src/client/page-policy.ts
new file mode 100644
index 0000000000..a1255dca76
--- /dev/null
+++ b/packages/client/ui-conversation/src/client/page-policy.ts
@@ -0,0 +1,85 @@
+/** Effect-owned constraints on the existing Conversation page, addressed by Session. */
+import { createSnapshotStore, type ObservableSnapshot, type SnapshotStore } from '@deepseek-ai/dsh-client-store'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+
+/** Constraints combine across owners; releasing one owner cannot release another. */
+export interface ConversationPagePolicy {
+  /** Keep native text/model controls while disabling tools, references and attachments. */
+  readonly textOnly?: boolean
+  /** Disable the native composer and its model controls. Host admission is separate. */
+  readonly readOnly?: boolean
+  /** Temporarily expose registered views without changing global preferences. */
+  readonly revealViews?: readonly string[]
+}
+
+const EMPTY: ConversationPagePolicy = Object.freeze({})
+
+/** Page policy and mounted-view observation share no conversation projection state. */
+export class ConversationPages {
+  private readonly owners = new Map<SessionId, Map<object, ConversationPagePolicy>>()
+  private readonly policies = new Map<SessionId, SnapshotStore<ConversationPagePolicy>>()
+  private readonly policyListeners = new Set<() => void>()
+  private readonly listeners = new Set<() => void>()
+  private readonly displays = new Map<object, { sessionId: SessionId; view: string }>()
+
+  /** Read the effective policy; absence is the ordinary product experience. */
+  for(sessionId: SessionId | undefined): ObservableSnapshot<ConversationPagePolicy> {
+    if (sessionId === undefined) return { getSnapshot: () => EMPTY, subscribe: () => () => {} }
+    let store = this.policies.get(sessionId)
+    if (store === undefined) { store = createSnapshotStore(EMPTY); this.policies.set(sessionId, store) }
+    return store
+  }
+
+  /** Acquire one independent lease; callers release it on owner teardown or chapter exit. */
+  constrain(sessionId: SessionId, policy: ConversationPagePolicy): () => void {
+    const token = {}
+    const owners = this.owners.get(sessionId) ?? new Map<object, ConversationPagePolicy>()
+    this.owners.set(sessionId, owners)
+    owners.set(token, { ...policy, revealViews: [...policy.revealViews ?? []] })
+    const publish = (): void => {
+      this.for(sessionId)
+      const values = [...owners.values()]
+      this.policies.get(sessionId)?.set(values.length === 0 ? EMPTY : {
+        textOnly: values.some(value => value.textOnly),
+        readOnly: values.some(value => value.readOnly),
+        revealViews: [...new Set(values.flatMap(value => value.revealViews ?? []))],
+      })
+      for (const listener of this.policyListeners) listener()
+      for (const listener of this.listeners) listener()
+    }
+    publish()
+    return () => {
+      if (!owners.delete(token)) return
+      if (owners.size === 0) this.owners.delete(sessionId)
+      publish()
+    }
+  }
+
+  /** Observe constraints without reacting to view mount/unmount notifications. */
+  subscribePolicies(listener: () => void): () => void {
+    this.policyListeners.add(listener)
+    return () => { this.policyListeners.delete(listener) }
+  }
+
+  /** Observe policy or actually displayed-view changes. Projection activation does not publish here. */
+  subscribe(listener: () => void): () => void {
+    this.listeners.add(listener)
+    return () => { this.listeners.delete(listener) }
+  }
+
+  /** True only while the addressed view has a mounted, ready display. */
+  isDisplayed(sessionId: SessionId, view: string): boolean {
+    return [...this.displays.values()].some(display => display.sessionId === sessionId && display.view === view)
+  }
+
+  /** Native view lifecycle only: revoke when hidden, unmounted or no longer ready. */
+  display(sessionId: SessionId, view: string): () => void {
+    const token = {}
+    this.displays.set(token, { sessionId, view })
+    for (const listener of this.listeners) listener()
+    return () => {
+      if (!this.displays.delete(token)) return
+      for (const listener of this.listeners) listener()
+    }
+  }
+}
