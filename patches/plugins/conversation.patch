index 0000000000..c6b5f490fe
--- /dev/null
+++ b/packages/client/ui-conversation/tests/composer-blocks.client.spec.ts
@@ -0,0 +1,25 @@
+import { expect, it } from 'vitest'
+import { SessionId } from '@deepseek-ai/dsh-session/types'
+import { ComposerBlockRegistry } from '../src/client/input/blocks.ts'
+it('keeps independent blockers until each owner releases its own entry', () => {
+  const blocks = new ComposerBlockRegistry(), id = SessionId('fixture')
+  blocks.set(id, { reason: 'model' })
+  blocks.set(id, { reason: 'configuration' }, 'configuration')
+  blocks.set(id, undefined)
+  expect(blocks.storeFor(id).getSnapshot()).toEqual({ reason: 'configuration' })
+  blocks.set(id, undefined, 'configuration')
+  expect(blocks.storeFor(id).getSnapshot()).toBeUndefined()
+  blocks.set(id, { reason: 'again' }, 'configuration')
+  blocks.forget(id)
+  expect(blocks.storeFor(id).getSnapshot()).toBeUndefined()
+})
+
+it('preserves editing restrictions when another owner blocks only submission', () => {
+  const blocks = new ComposerBlockRegistry(), id = SessionId('run')
+  blocks.set(id, { reason: 'saving', submissionOnly: true }, 'run')
+  expect(blocks.storeFor(id).getSnapshot()).toEqual({ reason: 'saving', submissionOnly: true })
+  blocks.set(id, { reason: 'unconfigured' }, 'configuration')
+  expect(blocks.storeFor(id).getSnapshot()).toEqual({ reason: 'unconfigured' })
+  blocks.set(id, undefined, 'configuration')
+  expect(blocks.storeFor(id).getSnapshot()).toEqual({ reason: 'saving', submissionOnly: true })
+})
