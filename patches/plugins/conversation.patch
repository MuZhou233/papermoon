diff --git a/packages/client/ui-conversation/tests/page-policy.client.spec.ts b/packages/client/ui-conversation/tests/page-policy.client.spec.ts
new file mode 100644
index 0000000000..397ce9100d
--- /dev/null
+++ b/packages/client/ui-conversation/tests/page-policy.client.spec.ts
@@ -0,0 +1,42 @@
+import { describe, expect, it, vi } from 'vitest'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import { ConversationPages } from '../src/client/page-policy.ts'
+
+describe('native page ownership', () => {
+  it('combines independent owners without leaking to other sessions or clearing another restriction', () => {
+    const pages = new ConversationPages()
+    const session = 'practice' as SessionId
+    const ordinary = 'ordinary' as SessionId
+    const source = pages.for(session)
+    const first = pages.constrain(session, { textOnly: true, revealViews: ['trajectory'] })
+    const second = pages.constrain(session, { readOnly: true })
+    expect(source.getSnapshot()).toEqual({ textOnly: true, readOnly: true, revealViews: ['trajectory'] })
+    expect(pages.for(ordinary).getSnapshot()).toEqual({})
+    first(); first()
+    expect(source.getSnapshot()).toEqual({ textOnly: false, readOnly: true, revealViews: [] })
+    second()
+    expect(source.getSnapshot()).toEqual({})
+  })
+
+  it('requires actual display and releases each mounted occurrence independently', () => {
+    const pages = new ConversationPages()
+    const session = 'example' as SessionId
+    const changed = vi.fn()
+    const off = pages.subscribe(changed)
+    pages.constrain(session, { revealViews: ['trajectory'] })
+    expect(pages.isDisplayed(session, 'trajectory')).toBe(false)
+    const chat = pages.display(session, 'chat')
+    expect(pages.isDisplayed(session, 'trajectory')).toBe(false)
+    const first = pages.display(session, 'trajectory')
+    const second = pages.display(session, 'trajectory')
+    first(); first()
+    expect(pages.isDisplayed(session, 'trajectory')).toBe(true)
+    second()
+    expect(pages.isDisplayed(session, 'trajectory')).toBe(false)
+    expect(pages.isDisplayed(session, 'chat')).toBe(true)
+    chat(); off()
+    const calls = changed.mock.calls.length
+    pages.display(session, 'trajectory')
+    expect(changed).toHaveBeenCalledTimes(calls)
+  })
+})
