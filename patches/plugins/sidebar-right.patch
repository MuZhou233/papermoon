@@ -0,0 +1,101 @@
+/** Page-owned docking surfaces share the right column without a Session lifetime. */
+import { DockController } from '@deepseek-ai/dsh-client-ui-dockkit'
+import type { DockSnapshot, DockIntents } from '@deepseek-ai/dsh-client-ui-dockkit'
+import type { SidebarRightTabRegistry } from './tab-registry.ts'
+/** Expansion control for a retained page resource. */
+export interface PageSidebarSurface {
+  /** @param expanded - whether the page panel is visible. */
+  setExpanded(expanded: boolean): void
+}
+/** Public navigation face; docking engine state remains owned by the sidebar. */
+export interface PageSidebarNavigation {
+  /** @param panelId - root page owner. @param contextId - resource identity, or null to release the visible binding. */
+  bind(panelId: string, contextId: string | null): void
+  /** Add a registered tab while preserving tool selection and expansion.
+   * @param contextId - bound page resource. @param kind - registered tab kind.
+   */
+  ensure(contextId: string, kind: string): void
+  /** Select and expand a tab after explicit navigation.
+   * @param contextId - bound page resource. @param kind - registered tab kind.
+   */
+  open(contextId: string, kind: string): void
+  /** @param contextId - retained page resource. @returns its expansion control, when present. */
+  surface(contextId: string): PageSidebarSurface | undefined
+}
+export interface PageSurface {
+  readonly panelId: string
+  readonly contextId: string
+  readonly controller: DockIntents & PageSidebarSurface
+  readonly snapshot: DockSnapshot
+}
+/** Page bindings select retained surfaces; only user navigation opens a tab. */
+export class PageSidebars implements PageSidebarNavigation {
+  private readonly surfaces = new Map<string, DockController>()
+  private readonly panels = new Map<string, string>()
+  private readonly listeners = new Set<() => void>()
+  private value: readonly PageSurface[] = []
+  constructor(private readonly tabs: SidebarRightTabRegistry) {}
+  subscribe = (listener: () => void): (() => void) => { this.listeners.add(listener); return () => { this.listeners.delete(listener) } }
+  getSnapshot = (): readonly PageSurface[] => this.value
+  private publish() {
+    this.value = [...this.panels].map(([panelId, contextId]) => {
+      const controller = this.surfaces.get(contextId)
+      if (!controller) throw new Error('bound page sidebar surface is missing')
+      return { panelId, contextId, controller, snapshot: controller.getSnapshot() }
+    })
+    for (const listener of this.listeners) listener()
+  }
+  /** @param panelId - root page owner. @param contextId - resource identity, or null to release this page. */
+  bind(panelId: string, contextId: string | null): void {
+    if (contextId === null) { this.panels.delete(panelId); this.publish(); return }
+    if (this.panels.get(panelId) === contextId) return
+    if (!this.surfaces.has(contextId)) {
+      const controller = new DockController()
+      controller.setExpanded(false)
+      const key = 'dsh.page-sidebar/' + contextId
+      try {
+        const preference = JSON.parse(localStorage.getItem(key) ?? 'null') as { kinds: string[]; active?: string; expanded: boolean } | null
+        if (preference) {
+          for (const kind of preference.kinds) { const tab = this.tabs.get(kind); if (tab) controller.openContent({ kind, contentId: 'sidebar://' + kind, title: tab.title('sidebar://' + kind) }) }
+          const active = Object.values(controller.getSnapshot().state.tabs).find(tab => tab.kind === preference.active)
+          if (active) controller.focusTab(active.id)
+          controller.setExpanded(preference.expanded)
+        }
+      } catch { /* Presentation preferences are optional. */ }
+      controller.subscribe(() => {
+        const state = controller.getSnapshot().state, pane = state.nodes[state.activePaneId]
+        const active = pane?.kind === 'pane' && pane.activeTabId ? state.tabs[pane.activeTabId]?.kind : undefined
+        try {
+          const kinds = Object.values(state.tabs).map(tab => tab.kind)
+          localStorage.setItem(key, JSON.stringify({ kinds, active, expanded: state.expanded }))
+        } catch { /* Keep the in-memory presentation. */ }
+        this.publish()
+      })
+      this.surfaces.set(contextId, controller)
+    }
+    this.panels.set(panelId, contextId); this.publish()
+  }
+  /** Register a page tab while retaining the current tool and expansion choice.
+   * @param contextId - bound resource. @param kind - registered tab kind.
+   */
+  ensure(contextId: string, kind: string): void {
+    const controller = this.surfaces.get(contextId), definition = this.tabs.get(kind)
+    if (!controller || !definition) return
+    const state = controller.getSnapshot().state
+    if (Object.values(state.tabs).some(tab => tab.kind === kind)) return
+    const pane = state.nodes[state.activePaneId]
+    controller.openContent({ kind, contentId: 'sidebar://' + kind, title: definition.title('sidebar://' + kind) })
+    if (pane?.kind === 'pane' && pane.activeTabId) controller.focusTab(pane.activeTabId)
+    controller.setExpanded(state.expanded)
+  }
+  /** @param contextId - bound page resource. @param kind - registered page-capable tab kind. */
+  open(contextId: string, kind: string): void {
+    const controller = this.surfaces.get(contextId), definition = this.tabs.get(kind)
+    if (!controller || !definition) throw new Error('page sidebar context or tab is unavailable')
+    const address = 'sidebar://' + kind
+    controller.openContent({ kind, contentId: address, title: definition.title(address) })
+    controller.setExpanded(true)
+  }
+  /** @param contextId - retained page resource. @returns the current docking surface. */
+  surface(contextId: string): DockController | undefined { return this.surfaces.get(contextId) }
+}
