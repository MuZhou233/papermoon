+/** Page tabs use the shared docking renderer and frame geometry. */
+import { useLayoutEffect } from 'react'
+import type { CSSProperties } from 'react'
+import { DockLayout } from '@deepseek-ai/dsh-client-ui-dockkit'
+import type { PropsLocale, PropsRenderSlots, PropsRuntime } from '@deepseek-ai/dsh-client-ui-slots'
+import { Button, IconPanelLeftOutlineRegular } from '@deepseek-ai/dsh-client-ui-primitives'
+import type { PageSurface } from '../page-surfaces.ts'
+import { dockLabels } from '../labels.ts'
+import css from './SidebarRight.module.css'
+import expandCss from './ExpandButton.module.css'
+
+type Props = PropsRuntime<'rightbar.page'> & PropsLocale<'sidebarRight'> & PropsRenderSlots<'sidebar.right.page.tab' | 'sidebar.right.page.tab.title' | 'sidebar.right.page.notice'> & {
+  surface: PageSurface
+  syncPresentation: (expanded: boolean, fullscreen: boolean) => void
+}
+/** @param props - selected page, docking snapshot and frame geometry. @returns a page-bound right panel. */
+export function PageRightbar({ surface, width, canShow, renderSlot, t, syncPresentation }: Props) {
+  const { state } = surface.snapshot, fullscreen = !canShow || state.mode === 'fullscreen'
+  useLayoutEffect(() => {
+    syncPresentation(state.expanded, fullscreen)
+    return () => { syncPresentation(false, false) }
+  }, [state.expanded, fullscreen, syncPresentation])
+  return <>
+    {!state.expanded && <div className={css.pageCorner}>
+      {renderSlot('sidebar.right.page.notice', { contextId: surface.contextId })}
+      <Button size="sm" className={expandCss.button} aria-label={t('chrome.expandAria')}
+        data-sidebar-right-expand onClick={() => { surface.controller.setExpanded(true) }}>
+        <IconPanelLeftOutlineRegular />
+      </Button>
+    </div>}
+    <div className={css.panel} style={{ width: fullscreen ? '100vw' : width, '--dsh-sidebar-width': fullscreen ? '100vw' : `${width}px` } as CSSProperties} data-sidebar-right-page={surface.contextId} data-sidebar-right-panel={fullscreen ? 'fullscreen' : 'push'} data-sidebar-right-open={state.expanded || undefined} aria-hidden={!state.expanded || undefined}>
+      <div className={css.panelBody}><DockLayout state={state} intents={surface.controller} labels={dockLabels(t)}
+        canSplit={false} canAddTab={() => false} canCloseTab={() => Object.keys(state.tabs).length > 1}
+        renderTabTitle={tab => renderSlot('sidebar.right.page.tab.title', { contextId: surface.contextId, tab }, { entryKey: tab.kind })}
+        renderTab={tab => renderSlot('sidebar.right.page.tab', { contextId: surface.contextId, tab, visible: state.expanded && Object.values(state.nodes).some(node => node.kind === 'pane' && node.activeTabId === tab.id) }, { entryKey: tab.kind })}
+        chrome={<Button size="sm" aria-label={t('chrome.collapseAria')} onClick={() => { surface.controller.setExpanded(false) }}>
+          <IconPanelLeftOutlineRegular />
+        </Button>} /></div>
+    </div>
+  </>
+}
