@@ -0,0 +1,35 @@
+// @vitest-environment jsdom
+import { beforeEach, expect, it } from 'vitest'
+import { Context } from '@deepseek-ai/cordis'
+import { SidebarRightTabRegistry } from '../src/client/tab-registry.ts'
+import { PageSidebars } from '../src/client/page-surfaces.ts'
+beforeEach(() => { localStorage.clear() })
+function fixture() {
+  const tabs = new SidebarRightTabRegistry(new Context())
+  for (const kind of ['story', 'notes']) tabs.register({ id: kind, kind, title: () => kind })
+  return { tabs, pages: new PageSidebars(tabs) }
+}
+it('retains independent page choices and makes a guide available without taking focus', () => {
+  const { pages } = fixture()
+  pages.bind('editor', 'first'); pages.open('first', 'notes'); pages.surface('first')!.setExpanded(false)
+  pages.ensure('first', 'story')
+  let state = pages.surface('first')!.getSnapshot().state
+  expect(state.expanded).toBe(false)
+  const pane = state.nodes[state.activePaneId]!
+  expect(pane.kind === 'pane' && state.tabs[pane.activeTabId!]!.kind).toBe('notes')
+  pages.bind('editor', 'second'); pages.ensure('second', 'story')
+  expect(pages.getSnapshot()[0]!.contextId).toBe('second')
+  pages.open('second', 'story')
+  expect(pages.surface('first')!.getSnapshot().state.expanded).toBe(false)
+  pages.bind('editor', null); expect(pages.getSnapshot()).toEqual([])
+  pages.bind('editor', 'first'); state = pages.getSnapshot()[0]!.snapshot.state
+  expect(Object.values(state.tabs).map(tab => tab.kind)).toEqual(['notes', 'story'])
+})
+it('restores display preferences without creating a Session or opening on an update', () => {
+  const { pages, tabs } = fixture()
+  pages.bind('editor', 'save'); pages.open('save', 'story'); pages.surface('save')!.setExpanded(false)
+  const restored = new PageSidebars(tabs)
+  restored.bind('editor', 'save'); restored.ensure('save', 'story')
+  expect(restored.getSnapshot()[0]!.snapshot.state.expanded).toBe(false)
+  expect(Object.values(restored.getSnapshot()[0]!.snapshot.state.tabs)).toHaveLength(1)
+})
