+// @vitest-environment jsdom
+import { Context } from '@deepseek-ai/cordis'
+import { expect, it, vi } from 'vitest'
+import { UiConversation } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import { MutableSessionEventSource, type ISessions, type SessionBinding } from '@deepseek-ai/dsh-api-session-controller/client'
+import { createUserMessage, createAssistantMessage } from '@deepseek-ai/dsh-llm'
+import { SessionId, SessionSeq, type SessionEvent } from '@deepseek-ai/dsh-session/types'
+import { registerConversationNodes } from '../src/client/conversation-nodes/register.ts'
+import { ChatPresentation } from '../src/client/chat-presentation.ts'
+
+it('publishes late registrations and releases only the disposing owner', async () => {
+  const ctx = new Context()
+  const provider = ctx.plugin({ apply: (inner: Context) => { new ChatPresentation(inner) } })
+  await provider
+  const service = ctx.chatPresentation
+  const changed = vi.fn()
+  const unsubscribe = service.presets.subscribe(changed)
+  expect(service.presets.getSnapshot()).toEqual([])
+  const owner = () => ctx.plugin({ inject:['chatPresentation'], apply(inner: Context) { inner.chatPresentation.preserveReplies('narrator') } })
+  const first = owner(), second = owner()
+  await first; await second
+  expect(service.presets.getSnapshot()).toEqual(['narrator'])
+  await first.dispose()
+  expect(service.presets.getSnapshot()).toEqual(['narrator'])
+  await second.dispose()
+  expect(service.presets.getSnapshot()).toEqual([])
+  expect(changed).toHaveBeenCalled()
+  unsubscribe(); await provider.dispose()
+})
+
+it('orders replayed inputs before thought controls in live and rebuilt Chat history', async () => {
+  const ctx = new Context()
+  const feed = new MutableSessionEventSource()
+  const source = { sessionId: SessionId('replayed-chat'), ctx, eventSource: feed } as unknown as SessionBinding
+  new UiConversation(ctx, { binding: () => source } as unknown as ISessions)
+  registerConversationNodes(ctx)
+  const binding = ctx.uiConversation.binding(source)
+  binding.activate('chat')
+  const chat = binding.target('chat')
+  const append = (event: SessionEvent): void => { feed.append({ type: 'event', event }) }
+  const replay = createUserMessage({ content: [{ type: 'text', text: 'Replayed question' }], source: { kind: 'user' } })
+  const injected = createUserMessage({ content: [{ type: 'text', text: 'Injected policy' }], source: { kind: 'authored-context', producer: 'policy-producer' } })
+  const kinds = () => { const value = chat.getSnapshot()!; return value.order.map(key => value.nodes.get(key)?.kind) }
+  try {
+    append({ seq: SessionSeq(1), time: 1, type: 'turn/start', data: { turn: 1 } })
+    append({ seq: SessionSeq(2), time: 2, type: 'user/message', surfaceOp: 'append', data: replay })
+    expect(kinds()).toEqual(['user', 'turn-process'])
+    append({ seq: SessionSeq(3), time: 3, type: 'user/message', surfaceOp: 'append', data: injected })
+    append({ seq: SessionSeq(4), time: 4, type: 'step/start', data: { turn: 1, step: 1 } })
+    append({ seq: SessionSeq(5), time: 5, type: 'assistant/message', surfaceOp: 'append', data: { turn: 1, step: 1, stream: [], message: createAssistantMessage({ content: [{ type: 'reasoning', text: 'Recorded thought' }, { type: 'text', text: 'Reply' }], source: { provider: 'test', model: 'test' } }) } })
+    append({ seq: SessionSeq(6), time: 6, type: 'step/end', data: { turn: 1, step: 1 } })
+    append({ seq: SessionSeq(7), time: 7, type: 'turn/end', data: { turn: 1, reason: { kind: 'completed' } } })
+    expect(kinds().slice(0, 3)).toEqual(['user', 'turn-process', 'assistant-step'])
+    expect([...chat.getSnapshot()!.nodes.values()].find(node => node.kind === 'context')?.data).toMatchObject({ source: injected.source })
+    expect(chat.getSnapshot()!.navigation.items()[0]?.prompt).toBe('Replayed question')
+    const input = chat.getSnapshot()!.nodes.values().find(node => node.kind === 'user')!
+    expect(input.data).toMatchObject({ content: replay.content, source: replay.source })
+    expect({
+      order: kinds(),
+      navigation: chat.getSnapshot()!.navigation.items().map(({ turn, prompt, response }) => ({ turn, prompt, response })),
+      input: { kind: input.kind, source: replay.source, content: replay.content },
+    }).toMatchSnapshot()
+    expect(feed.getSnapshot().entries[1]?.event.data).toBe(replay)
+  } finally { await ctx.fiber.dispose() }
+})
+
+it('renders accepted user input outside a turn without creating an execution', async () => {
+  const ctx = new Context()
+  const feed = new MutableSessionEventSource()
+  const source = { sessionId: SessionId('interrupted'), ctx, eventSource: feed } as unknown as SessionBinding
+  new UiConversation(ctx, { binding: () => source } as unknown as ISessions)
+  registerConversationNodes(ctx)
+  const binding = ctx.uiConversation.binding(source)
+  binding.activate('chat')
+  try {
+    const message = createUserMessage({ content: [{ type: 'text', text: 'Accepted before interruption' }], source: { kind: 'user' } })
+    feed.append({ type: 'event', event: { seq: SessionSeq(1), time: 1, type: 'context/message', surfaceOp: 'append', data: { groupId: 'accepted-input', index: 0, message } } })
+    const snapshot = binding.target('chat').getSnapshot()!
+    expect(snapshot.order.map(key => snapshot.nodes.get(key)?.kind)).toEqual(['user'])
+    expect(snapshot.navigation.items()).toEqual([])
+  } finally { await ctx.fiber.dispose() }
+})
