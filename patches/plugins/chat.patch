diff --git a/packages/client/ui-chat/src/client/chat-presentation.ts b/packages/client/ui-chat/src/client/chat-presentation.ts
new file mode 100644
index 0000000000..1b6a649da0
--- /dev/null
+++ b/packages/client/ui-chat/src/client/chat-presentation.ts
@@ -0,0 +1,49 @@
+/** Client-owned presentation registrations; no Session or model input changes. */
+import { Service, type Context } from '@deepseek-ai/cordis'
+import { createSnapshotStore, type ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+
+/** Presentation policies registered by Client plugins. */
+export interface IChatPresentation {
+  /** Presets whose reply-bearing steps remain visible in Compact display. */
+  readonly presets: ObservableSnapshot<readonly string[]>
+  /**
+   * Keep reply text visible for one preset while retaining process disclosures.
+   * @param preset - Session preset identity.
+   * @returns release this registration; also released with the calling plugin.
+   */
+  preserveReplies(preset: string): () => void
+
+}
+
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Client Chat presentation registrations. */
+    chatPresentation: IChatPresentation
+  }
+}
+
+/** Effect-owned preset policies with observable registration and removal. */
+export class ChatPresentation extends Service implements IChatPresentation {
+  private readonly registrations = new Map<symbol, string>()
+  private readonly store = createSnapshotStore<readonly string[]>([])
+  /** Shared immutable preset snapshot. */
+  readonly presets: ObservableSnapshot<readonly string[]> = this.store
+
+  /**
+   * Install the Client presentation service.
+   * @param ctx - Owning Chat plugin context.
+   */
+  constructor(ctx: Context) { super(ctx, 'chatPresentation') }
+
+  preserveReplies(preset: string): () => void {
+    const dispose = this.ctx.effect(() => {
+      const id = Symbol(preset)
+      this.registrations.set(id, preset)
+      this.publish()
+      return () => { this.registrations.delete(id); this.publish() }
+    }, `chatPresentation.preserveReplies(${JSON.stringify(preset)})`)
+    return () => { void dispose() }
+  }
+
+  private publish(): void { this.store.set([...new Set(this.registrations.values())]) }
+}
