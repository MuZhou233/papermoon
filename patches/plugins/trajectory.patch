+import type { TrajectoryTurnModel } from './layout.ts'
+
+function source(block: ContentBlock): TrajectorySourceBlock {
+  if (block.type === 'text' || block.type === 'reasoning') return { type:block.type, content:block.text }
+  if (block.type === 'image') return { type:block.type, content:JSON.stringify(block), attachment:block.attachment }
+  if (block.type === 'tool-call') return { type:block.type, content:block.arguments, callId:block.id, toolName:block.name }
+  return { type:block.type, content:JSON.stringify(block) }
+}
+/**
+ * Expand saved messages in supplied order, without event sorting or timing inference.
+ * @param messages - Exact model messages and their optional source coordinates.
+ * @param label - Localized context section label.
+ * @returns timeless records using the full trajectory detail renderer.
+ */
+export function contextLayout(messages: readonly TrajectoryContextMessage[], label: string): TrajectoryTurnModel[] {
+  const cells: TrajectoryCellProps[] = []
+  for (const item of messages) {
+    const blocks=item.message.content
+    const text=blocks.filter(block=>block.type==='text').map(block=>block.text).join('')
+    const thinking=blocks.filter(block=>block.type==='reasoning').map(block=>block.text).join('')
+    const common = {
+      recordId: item.id, timeSeconds: null, messageSource: item.message.source,
+      ...(item.sourceSeq === undefined ? {} : { sourceSeq: item.sourceSeq }),
+      ...(item.sourceTarget === undefined ? {} : { inspectionSource: item.sourceTarget }),
+      ...(item.label === undefined ? {} : { inspectionLabel: item.label }),
+      sourceBlocks: blocks.map(source),
+    }
+    const message = item.message
+    if (message.role === 'tool') {
+      const call = cells.findLast(cell => cell.callId === message.toolCallId)
+      if (call) {
+        call.outputDetail = text
+        call.outputBlocks = blocks.map(source)
+        call.result = text
+        call.isError = message.isError ?? false
+        continue
+      }
+    }
+    cells.push({ ...common,index:cells.length+1,kind:item.message.role==='system'?'system':item.message.role==='assistant'?'message':'user',
+      text:item.label??'',previewMarkdown:text,
+      ...(item.message.role==='system'?{ systemPromptDetail:text }:item.message.role==='assistant'?{ outputDetail:text,thinkingDetail:thinking }:{ inputDetail:text }) })
+    for(const block of blocks) if(block.type==='tool-call') cells.push({ ...common,index:cells.length+1,recordId:item.id+':'+block.id,kind:'tool',text:block.name,callId:block.id,inputDetail:block.arguments })
+  }
+  return cells.length ? [{ turn:null,label,groups:[{ title:label,cells }] }] : []
+}
+/**
+ * Prepend ordered context without changing execution grouping or source identities.
+ * @param context - Context-only groups without timing or usage.
+ * @param execution - Real execution groups.
+ * @returns combined ledger with unique presentation indexes.
+ */
+export function prependContext(context: readonly TrajectoryTurnModel[], execution: readonly TrajectoryTurnModel[]): TrajectoryTurnModel[] {
+  let index=0
+  return [...context, ...execution].map(turn => ({
+    ...turn,
+    groups: turn.groups.map(group => ({
+      ...group, cells: group.cells.map(cell => ({ ...cell, index: ++index })),
+    })),
+  }))
+}
