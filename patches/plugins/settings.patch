diff --git a/packages/client/ui-settings-general/src/client/navigation.ts b/packages/client/ui-settings-general/src/client/navigation.ts
new file mode 100644
index 0000000000..116f36198a
--- /dev/null
+++ b/packages/client/ui-settings-general/src/client/navigation.ts
@@ -0,0 +1,48 @@
+/** Settings navigation and mounted-section observations shared by entry points. */
+import { Service, type Context } from '@deepseek-ai/cordis'
+
+/** Shared navigation and display acknowledgements for the settings dialog. */
+export interface ISettingsNavigation {
+  /** Open a registered section.
+   * @param section - Registered section identifier.
+   * @returns False while the shell is unavailable; true after asking it to open.
+   */
+  open(section: string): boolean
+  /** Observe actual mounts, including navigation within an already open dialog.
+   * @param listener - Receives the mounted section, or undefined on close.
+   * @returns Effect-owned subscription disposer.
+   */
+  subscribe(listener: (section: string | undefined) => void): () => void
+}
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Settings dialog navigation without DOM queries or simulated clicks. */
+    settingsNavigation: ISettingsNavigation
+  }
+}
+export class SettingsNavigation extends Service implements ISettingsNavigation {
+  private opener: ((section: string) => void) | undefined
+  private readonly listeners = new Set<(section: string | undefined) => void>()
+  constructor(ctx: Context) { super(ctx, 'settingsNavigation') }
+  open(section: string): boolean {
+    if (!this.opener) return false
+    this.opener(section)
+    return true
+  }
+  subscribe(listener: (section: string | undefined) => void): () => void {
+    const dispose = this.ctx.effect(() => {
+      this.listeners.add(listener)
+      return () => { this.listeners.delete(listener) }
+    }, 'settingsNavigation.subscribe')
+    return () => { void dispose() }
+  }
+  /** Bind one mounted settings shell; teardown makes navigation unavailable. */
+  bind(opener: (section: string) => void): () => void {
+    this.opener = opener
+    return () => { if (this.opener === opener) this.opener = undefined }
+  }
+  /** Called after the dialog commits its selected section to the screen. */
+  displayed(section: string | undefined): void {
+    for (const listener of this.listeners) listener(section)
+  }
+}
