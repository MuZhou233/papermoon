index 0000000000..c63122c417
--- /dev/null
+++ b/packages/core/agent-loop/src/history-selection.ts
@@ -0,0 +1,24 @@
+/** Host projection keeps selection identity available outside the loaded history window. */
+import { z } from 'zod'
+import type { ProjectionDefinition } from '@deepseek-ai/dsh-session-projection'
+import { SessionSeq, type SessionHistorySelection } from '@deepseek-ai/dsh-session'
+declare module '@deepseek-ai/dsh-session-projection' {
+  interface SessionProjectionStateMap { historySelection: SessionHistorySelection | null }
+  interface SessionProjectionMap { historySelection: SessionHistorySelection | null }
+}
+const schema = z.object({
+  seq: z.number().int().nonnegative().transform(SessionSeq),
+  version: z.number().int().positive(),
+  ranges: z.array(z.object({
+    start: z.number().int().nonnegative().transform(SessionSeq),
+    end: z.number().int().nonnegative().transform(SessionSeq),
+  })),
+}).nullable()
+/** Whole selected-history reference carried by snapshots and live projection frames. */
+export const historySelectionProjection = {
+  key: 'historySelection', stateVersion: 1,
+  stateSchema: schema,
+  init: () => null,
+  apply: (state, event) => event.type === 'history/selected' ? { seq: event.seq, version: event.data.version, ranges: event.data.ranges } : state,
+  wire: { viewSchema: schema, view: state => state },
+} satisfies ProjectionDefinition<'historySelection', SessionHistorySelection | null>
