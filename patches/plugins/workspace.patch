+++ b/packages/client/ui-agent-preset/src/client/binding-state.ts
@@ -0,0 +1,32 @@
+/** Read-only preset state for product controls mounted in one Session. */
+import { createSnapshotStore, type ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+import type { SessionSummary } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { AgentPresetSeatController } from './seat-store.ts'
+
+/** A bound projection or the pending choice for a new Session. */
+export interface PresetBindingState {
+  current: string
+  busy: boolean
+}
+
+/**
+ * Derive a stable reader without giving consumers preset selection authority.
+ * @param seat - upstream picker for this binding.
+ * @param summary - current bound Session, independent of the active main panel.
+ * @returns snapshot reader and a refresh callback owned by the binding lifetime.
+ */
+export function presetBindingState(seat: Pick<AgentPresetSeatController, 'store'>, summary: () => Pick<SessionSummary, 'blank' | 'projectionValues'> | undefined): {
+  store: ObservableSnapshot<PresetBindingState>
+  refresh: () => void
+} {
+  const read = (): PresetBindingState => {
+    const session = summary(), selection = seat.store.getSnapshot()
+    const preset = session?.projectionValues?.['agentPreset']
+    return { current: typeof preset === 'string' ? preset : session?.blank ? selection.current : '', busy: selection.busy }
+  }
+  const store = createSnapshotStore(read())
+  return { store, refresh() {
+    const next = read(), previous = store.getSnapshot()
+    if (next.current !== previous.current || next.busy !== previous.busy) store.set(next)
+  } }
+}
