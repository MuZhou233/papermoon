+/** Durable identities prevent authored prefixes from being repeated after resume or Fork. */
+import { z } from 'zod'
+import type { ProjectionDefinition } from '@deepseek-ai/dsh-session-projection'
+
+declare module '@deepseek-ai/dsh-session-projection' {
+  interface SessionProjectionStateMap {
+    /** Authored message identities already committed, including replaced surface nodes. */
+    authoredContextIds: string[]
+  }
+}
+
+/** Host-only fold of committed authored-message identities. */
+export const authoredContextProjection = {
+  key: 'authoredContextIds',
+  stateVersion: 1,
+  stateSchema: z.array(z.string()),
+  init: () => [],
+  apply: (state, event) => event.type === 'context/message' && !state.includes(event.data.message.id)
+    ? [...state, event.data.message.id]
+    : state,
+} satisfies ProjectionDefinition<'authoredContextIds', string[]>
