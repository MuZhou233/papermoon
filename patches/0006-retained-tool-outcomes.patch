+describe('retained tool outcome recovery', () => {
+  function recovery() {
+    const evidence = provenanceEvent(SessionSeq(0), undefined)
+    const failed = toolResultEvent(SessionSeq(1), 'outcome') as Extract<SessionEvent, { type: 'tool/result' }>
+    failed.data = { ...failed.data, error: { name: 'ToolOutcomeUnknownError', code: 'TOOL_OUTCOME_UNKNOWN' }, message: freezeMessage({ ...failed.data.message, content: [{ ...failed.data.message.content[0], isError: true }] }) }
+    const { error: _error, ...success } = failed.data
+    const replacement: Extract<SessionEvent, { type: 'tool/result' }> = { ...failed, seq: SessionSeq(2), data: { ...success, message: freezeMessage({ ...success.message, content: [{ ...success.message.content[0], isError: false, content: [{ type: 'text', text: '3' }] }] }) }, surfaceOp: { op: 'replace', startSeq: SessionSeq(1), endSeq: SessionSeq(1) }, sourceEventSeqs: sourceSeqs(0, 1) }
+    return { evidence, failed, replacement }
+  }
+  it('retains the failed result while correcting the current outcome', () => {
+    const { evidence, failed, replacement } = recovery()
+    expect(() => foldSurface([evidence, failed, replacement])).not.toThrow()
+    expect(failed.data.message.content[0].isError).toBe(true)
+    expect(replacement.data.message.id).toBe(failed.data.message.id)
+  })
+  it.each([[1], [0], []])('rejects correction without both references: %j', (...values) => {
+    const { evidence, failed, replacement } = recovery()
+    replacement.sourceEventSeqs = sourceSeqs(...values)
+    expect(() => foldSurface([evidence, failed, replacement])).toThrow()
+  })
+  it('does not permit a correction to change message identity', () => {
+    const { evidence, failed, replacement } = recovery()
+    replacement.data = { ...replacement.data, message: freezeMessage({ ...replacement.data.message, id: MessageId('different') }) }
+    expect(() => foldSurface([evidence, failed, replacement])).toThrow(/may change only content/)
+  })
+})
