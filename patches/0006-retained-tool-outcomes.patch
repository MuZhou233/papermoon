+/** A retained outcome corrects its interrupted delivery through the Session surface. */
+export const inject = ['tools']
+export function apply(ctx) {
+  ctx.effect(() => ctx.tools.register({
+    name: 'retain_number', description: 'Retain the supplied number.',
+    parameters: { type: 'object', properties: { value: { type: 'number' } }, required: ['value'], additionalProperties: false },
+    output: { schema: { type: 'number' }, render: (_args, value) => [{ type: 'text', text: String(value) }] },
+    async execute(args, exec) {
+      exec.agent.session.append('session/configuration', { key: 'fixture.retained-outcome', value: { callId: exec.callId, value: args.value } })
+      throw new Error('delivery interrupted')
+    },
+  }))
+  ctx.on('agent/pre-step', async ({agent}, next) => {
+    const events = agent.session.snapshotEvents()
+    const retained = events.find(e => e.type === 'session/configuration' && e.data.key === 'fixture.retained-outcome')
+    if (retained) {
+      const receipt = events.filter(e => e.type === 'tool/result' && e.data.message.source.callId === retained.data.value.callId).at(-1)
+      if (receipt?.data.message.content[0].isError) {
+        const { error: _error, ...data } = receipt.data
+        agent.session.append('tool/result', { ...data, message: { ...data.message, content: [{ ...data.message.content[0], isError: false, content: [{ type:'text', text:String(retained.data.value.value) }] }] } }, { surfaceOp: { op:'replace', startSeq:receipt.seq, endSeq:receipt.seq }, sourceEventSeqs:[retained.seq,receipt.seq] })
+      }
+    }
+    return next()
+  })
+}
