+/** A deterministic authored prefix, supplied through the public pre-step hook. */
+export function apply(ctx) {
+  ctx.on('agent/created', ({ agent }) => {
+    agent.session.append('history/selected', { version: 1, ranges: [], metadata: { purpose: 'fixture' } })
+    agent.session.append('session/configuration', { key: 'fixture-opening', value: {}, presentation: { initialized: true, label: 'Reading', text: 'A named initial question.' } })
+  })
+  ctx.on('agent/pre-step', async (_payload, next) => {
+    const decision = await next()
+    if (decision.kind === 'reject') return decision
+    return { ...decision, initialMessages: [
+      { groupId: 'fixture-context', index: 0, name: 'Question', message: { id: 'fixture-question', role: 'user', content: [{ type: 'text', text: 'A named initial question.' }], source: { kind: 'plugin', plugin: 'fixture-context' } } },
+      { groupId: 'fixture-context', index: 1, name: 'Answer', message: { id: 'fixture-answer', role: 'assistant', content: [{ type: 'text', text: 'A supplied answer, not a generated attempt.' }], source: { kind: 'plugin', plugin: 'fixture-context' } } },
+    ] }
+  })
+}
