diff --git a/packages/client/ui-trajectory/src/client/inspection.ts b/packages/client/ui-trajectory/src/client/inspection.ts
new file mode 100644
index 0000000000..c3b20c4731
--- /dev/null
+++ b/packages/client/ui-trajectory/src/client/inspection.ts
@@ -0,0 +1,111 @@
+/** Effect-owned read-only trajectory sources, independent of the active Session history. */
+import { Service, type Context } from '@deepseek-ai/cordis'
+import { createSnapshotStore, type ObservableSnapshot } from '@deepseek-ai/dsh-client-store'
+import type { SessionBinding, SessionEventLikeEntry } from '@deepseek-ai/dsh-api-session-controller/client'
+import type { SessionId } from '@deepseek-ai/dsh-session/types'
+import type { Message } from '@deepseek-ai/dsh-llm'
+import type { TrajectorySnapshot } from './trajectory-contract.ts'
+import { EMPTY_TRAJECTORY_SNAPSHOT } from './trajectory-snapshot-builder.ts'
+
+/** One explicitly ordered message; provenance does not change its model role. */
+export interface TrajectoryContextMessage {
+  readonly id: string
+  readonly message: Message
+  readonly label?: string
+  readonly sourceSeq?: number
+  readonly sourceTarget?: string
+}
+/** A plugin-owned inspection window. Events retain original sequence and time. */
+export interface TrajectoryInspection {
+  readonly key: string
+  readonly events: readonly SessionEventLikeEntry[]
+  readonly context?: readonly TrajectoryContextMessage[]
+  /** Optional display-record identity to reveal when the inspection changes. */
+  readonly focusRecordId?: string
+  readonly contextLabel?: string
+  readonly turnLabels?: Readonly<Record<number, string>>
+  readonly loading?: boolean
+  readonly error?: string
+  readonly hasMore?: boolean
+  readonly loadMore?: () => Promise<boolean>
+  /** Last durable sequence included by the provider; later live entries belong to this execution. */
+  readonly liveAfter?: number
+  readonly openSource?: (target: string) => void
+  readonly readRequest?: (turn: number, step: number) => Promise<unknown>
+}
+/** Public registrations for Session-local inspection. */
+export interface ITrajectoryInspection {
+  /**
+   * Replace only the readonly trajectory source for one Session.
+   * @param sessionId - Session whose trajectory is being inspected.
+   * @param source - Stable observable inspection window, or null for the normal source.
+   * @returns idempotent, effect-owned registration disposer.
+   */
+  register(sessionId: SessionId, source: ObservableSnapshot<TrajectoryInspection | null>): () => void
+}
+declare module '@deepseek-ai/cordis' {
+  interface Context {
+    /** Readonly trajectory source registrations; does not select Session history. */
+    trajectoryInspection: ITrajectoryInspection
+  }
+}
+/** One provider per Session; unloading restores the normal conversation projection. */
+export class TrajectoryInspectionService extends Service implements ITrajectoryInspection {
+  private readonly sources = new Map<SessionId, ObservableSnapshot<TrajectoryInspection | null>>()
+  private readonly changes = createSnapshotStore(0)
+  /**
+   * Install the browser inspection service.
+   * @param ctx - Trajectory owner context with Conversation definitions.
+   */
+  constructor(ctx: Context) { super(ctx, 'trajectoryInspection') }
+  register(sessionId: SessionId, source: ObservableSnapshot<TrajectoryInspection | null>): () => void {
+    const dispose = this.ctx.effect(() => {
+      if (this.sources.has(sessionId)) throw new Error('trajectory inspection source is already registered')
+      this.sources.set(sessionId, source)
+      const notify = () => { this.changes.set(this.changes.getSnapshot() + 1) }
+      const off = source.subscribe(notify)
+      notify()
+      return () => { off(); this.sources.delete(sessionId); notify() }
+    }, 'trajectoryInspection.register')
+    return () => { void dispose() }
+  }
+  /**
+   * Resolve an isolated projection while keeping ordinary history as the default.
+   * @param binding - Session binding supplying live execution events.
+   * @param fallback - Normal trajectory projection.
+   * @returns observable inspection projection without modifying either source.
+   */
+  bind(binding: SessionBinding, fallback: ObservableSnapshot<TrajectorySnapshot>): ObservableSnapshot<TrajectorySnapshot> {
+    let last: TrajectoryInspection | null | undefined
+    let lastLive: unknown
+    let lastDefinitions: unknown
+    let lastViews: unknown
+    let snapshot = EMPTY_TRAJECTORY_SNAPSHOT
+    return {
+      getSnapshot: () => {
+        const input = this.sources.get(binding.session.sessionId)?.getSnapshot()
+        if (!input) return fallback.getSnapshot()
+        const live = input.liveAfter === undefined ? undefined : binding.eventSource.getSnapshot()
+        if (last === input && lastLive === live
+          && lastDefinitions === this.ctx.uiConversation.events.entries()
+          && lastViews === this.ctx.uiConversation.views.entries()) return snapshot
+        last = input; lastLive = live
+        lastDefinitions = this.ctx.uiConversation.events.entries(); lastViews = this.ctx.uiConversation.views.entries()
+        const after = input.liveAfter
+        const tail = after === undefined ? [] : live?.entries.filter(entry => entry.event.seq > after) ?? []
+        const end = tail.findIndex(entry => entry.event.type === 'turn/end')
+        const entries = [...input.events, ...tail.slice(0, end < 0 ? undefined : end + 1)]
+        const projected = this.ctx.uiConversation.inspect('trajectory', entries) ?? EMPTY_TRAJECTORY_SNAPSHOT
+        snapshot = { ...projected, inspection: input }
+        return snapshot
+      },
+      subscribe: (listener) => {
+        const off = [
+          this.changes.subscribe(listener), fallback.subscribe(listener), binding.eventSource.subscribe(listener),
+          this.ctx.uiConversation.events.subscribe(listener), this.ctx.uiConversation.views.subscribe(listener),
+        ]
+        return () => { for (const remove of off) remove() }
+      },
+    }
+  }
+}
