diff --git a/packages/client/ui-trajectory/tests/inspection.client.spec.ts b/packages/client/ui-trajectory/tests/inspection.client.spec.ts
new file mode 100644
index 0000000000..ff59f5c106
--- /dev/null
+++ b/packages/client/ui-trajectory/tests/inspection.client.spec.ts
@@ -0,0 +1,108 @@
+// @vitest-environment jsdom
+import { Context } from '@deepseek-ai/cordis'
+import { expect, it, vi } from 'vitest'
+import { createSnapshotStore } from '@deepseek-ai/dsh-client-store'
+import { createUserMessage, createAssistantMessage, ToolCallId } from '@deepseek-ai/dsh-llm'
+import { SessionId, SessionSeq } from '@deepseek-ai/dsh-session/types'
+import { UiConversation, ConversationNodeAssembler } from '@deepseek-ai/dsh-client-ui-conversation/client'
+import { MutableSessionEventSource, type SessionBinding, type ISessions } from '@deepseek-ai/dsh-api-session-controller/client'
+import { EMPTY_TRAJECTORY_SNAPSHOT, registerTrajectoryConversationView } from '../src/client/trajectory-snapshot-builder.ts'
+import { registerTrajectoryMessageDefinitions } from '../src/client/trajectory-message-definitions.ts'
+import { contextLayout, prependContext } from '../src/client/context-layout.ts'
+import { TrajectoryInspectionService, type TrajectoryInspection } from '../src/client/inspection.ts'
+
+it('preserves explicit order and source identities without counting cited execution again', () => {
+  const messages = [
+    { id:'later', sourceSeq:90, sourceTarget:'node-b', label:'Floor 2', message:createUserMessage({ content:[{ type:'text',text:'Later' }],source:{ kind:'user' } }) },
+    { id:'earlier', sourceSeq:10, sourceTarget:'node-a', label:'Floor 1', message:createAssistantMessage({ content:[{ type:'reasoning',text:'Recorded thought' },{ type:'text',text:'Earlier' },{ type:'tool-call',id:ToolCallId('call'),name:'look',arguments:'{}' }],source:{ provider:'test',model:'test' } }) },
+    { id:'result', message:createUserMessage({ content:[{ type:'tool-result',toolCallId:ToolCallId('call'),content:[{ type:'text',text:'Value' }] }],source:{ kind:'user' } }) },
+  ]
+  const layout=contextLayout(messages,'Context'), cells=layout.flatMap(turn=>turn.groups.flatMap(group=>group.cells))
+  expect(cells.map(cell=>cell.recordId)).toEqual(['later','earlier','earlier:call'])
+  expect(cells.map(cell=>cell.sourceSeq)).toEqual([90,10,10])
+  expect(cells[1]?.thinkingDetail).toBe('Recorded thought')
+  expect(cells[2]?.outputDetail).toBe('Value')
+  expect(cells.every(cell=>cell.timeSeconds===null&&cell.startedAt===undefined&&cell.output===undefined)).toBe(true)
+  const joined=prependContext(layout,[{ turn:3,groups:[{ title:'Step 1',cells:[{ index:1,kind:'message',text:'Actual',timeSeconds:2,sourceSeq:100 }] }] }])
+  expect(joined.flatMap(turn=>turn.groups.flatMap(group=>group.cells.map(cell=>cell.index)))).toEqual([1,2,3,4])
+  expect(joined).toMatchSnapshot()
+})
+
+it('releases an inspection provider with its plugin and rejects duplicate ownership', async () => {
+  const ctx=new Context(), owner=ctx.plugin({ apply(inner:Context){new TrajectoryInspectionService(inner)} })
+  await owner
+  const source=createSnapshotStore<TrajectoryInspection|null>(null)
+  const plugin=ctx.plugin({ inject:['trajectoryInspection'],apply(inner:Context){inner.trajectoryInspection.register(SessionId('one'),source)} })
+  await plugin
+  expect(()=>ctx.trajectoryInspection.register(SessionId('one'),source)).toThrow('already registered')
+  await plugin.dispose()
+  const off=ctx.trajectoryInspection.register(SessionId('one'),source)
+  off();off()
+  await owner.dispose()
+})
+
+it('isolates inspection windows, ends live tails at the turn boundary, and restores ordinary history', async () => {
+  const ctx=new Context()
+  new UiConversation(ctx, {} as ISessions)
+  const service=new TrajectoryInspectionService(ctx), feed=new MutableSessionEventSource()
+  const binding={ session:{ sessionId:SessionId('inspect') },eventSource:feed } as unknown as SessionBinding
+  const ordinary=createSnapshotStore({ ...EMPTY_TRAJECTORY_SNAPSHOT, registerTrajectoryConversationView })
+  const selected=createSnapshotStore<TrajectoryInspection|null>({ key:'one',events:[],liveAfter:0 })
+  const result=service.bind(binding,ordinary), notify=vi.fn(), off=result.subscribe(notify)
+  expect(result.getSnapshot()).toBe(ordinary.getSnapshot())
+  const dispose=service.register(SessionId('inspect'),selected)
+  const replace=vi.spyOn(ConversationNodeAssembler.prototype,'replaceWindow')
+  feed.append({ type:'event',event:{ seq:SessionSeq(1),time:1,type:'turn/start',data:{ turn:2 } } })
+  feed.append({ type:'event',event:{ seq:SessionSeq(2),time:2,type:'turn/end',data:{ turn:2,reason:{ kind:'completed' } } } })
+  feed.append({ type:'event',event:{ seq:SessionSeq(3),time:3,type:'turn/start',data:{ turn:3 } } })
+  expect(result.getSnapshot().inspection?.key).toBe('one')
+  expect(replace.mock.calls.at(-1)?.[0].map(entry=>entry.event.seq)).toEqual([1,2])
+  const snapshot=result.getSnapshot()
+  expect(result.getSnapshot()).toBe(snapshot)
+  expect(feed.getSnapshot().entries).toHaveLength(3)
+  selected.set({ key:'older',events:feed.getSnapshot().entries.slice(0,1) })
+  expect(result.getSnapshot().inspection?.key).toBe('older')
+  expect(replace.mock.calls.at(-1)?.[0]).toHaveLength(1)
+  dispose()
+  expect(result.getSnapshot()).toBe(ordinary.getSnapshot())
+  expect(notify).toHaveBeenCalled()
+  replace.mockRestore();off();await ctx.fiber.dispose()
+})
+
+it('retains every result in a multi-tool receipt without inventing an extra user record', () => {
+  const call=(id:string)=>({ type:'tool-call' as const,id:ToolCallId(id),name:id,arguments:'{}' })
+  const receipt=(id:string)=>({ type:'tool-result' as const,toolCallId:ToolCallId(id),content:[{ type:'text' as const,text:id+' result' }] })
+  const result=contextLayout([
+    { id:'calls',message:createAssistantMessage({ content:[call('a'),call('b')],source:{ provider:'test',model:'test' } }) },
+    { id:'results',message:createUserMessage({ content:[receipt('a'),receipt('b')],source:{ kind:'user' } }) },
+  ],'Context').flatMap(turn=>turn.groups.flatMap(group=>group.cells))
+  expect(result.map(cell=>cell.kind)).toEqual(['message','tool','tool'])
+  expect(result.slice(1).map(cell=>cell.outputDetail)).toEqual(['a result','b result'])
+})
+
+it('uses persisted user identity while retaining plugin context', async () => {
+  const ctx = new Context()
+  new UiConversation(ctx, {} as ISessions)
+  registerTrajectoryConversationView(ctx)
+  registerTrajectoryMessageDefinitions(ctx)
+  const service = new TrajectoryInspectionService(ctx), feed = new MutableSessionEventSource()
+  const binding = { session: { sessionId: SessionId('replay') }, eventSource: feed } as unknown as SessionBinding
+  const user = createUserMessage({ content: [{ type: 'text', text: 'First input' }], source: { kind: 'user' } })
+  const replay = createUserMessage({ content: [{ type: 'text', text: 'Replayed input' }], source: { kind: 'user' } })
+  const context = createUserMessage({ content: [{ type: 'text', text: 'Injected instructions' }], source: { kind: 'plugin', plugin: 'replay' } })
+  for (const [index, message] of [user, replay, context].entries()) {
+    feed.append({ type: 'event', event: { seq: SessionSeq(index + 1), time: index, type: 'user/message', surfaceOp: 'append', data: message } })
+  }
+  const input = { key: 'replay', events: feed.getSnapshot().entries }
+  const selected = createSnapshotStore<TrajectoryInspection | null>(input)
+  const off = service.register(SessionId('replay'), selected)
+  try {
+    const result = service.bind(binding, createSnapshotStore(EMPTY_TRAJECTORY_SNAPSHOT))
+    expect(result.getSnapshot().eventNodes.map(node => node.kind)).toEqual(['user', 'user', 'context'])
+    expect(result.getSnapshot().eventNodes[1]).toMatchObject({ source: replay.source, content: replay.content })
+    expect(feed.getSnapshot().entries[1]?.event.data).toBe(replay)
+  } finally {
+    off()
+    await ctx.fiber.dispose()
+  }
+})
