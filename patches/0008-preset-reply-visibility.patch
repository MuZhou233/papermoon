@@ -0,0 +1,24 @@
+// @vitest-environment jsdom
+import { Context } from '@deepseek-ai/cordis'
+import { expect, it, vi } from 'vitest'
+import { ChatPresentation } from '../src/client/chat-presentation.ts'
+
+it('publishes late registrations and releases only the disposing owner', async () => {
+  const ctx = new Context()
+  const provider = ctx.plugin({ apply: (inner: Context) => { new ChatPresentation(inner) } })
+  await provider
+  const service = ctx.chatPresentation
+  const changed = vi.fn()
+  const unsubscribe = service.presets.subscribe(changed)
+  expect(service.presets.getSnapshot()).toEqual([])
+  const owner = () => ctx.plugin({ inject:['chatPresentation'], apply(inner: Context) { inner.chatPresentation.preserveReplies('narrator') } })
+  const first = owner(), second = owner()
+  await first; await second
+  expect(service.presets.getSnapshot()).toEqual(['narrator'])
+  await first.dispose()
+  expect(service.presets.getSnapshot()).toEqual(['narrator'])
+  await second.dispose()
+  expect(service.presets.getSnapshot()).toEqual([])
+  expect(changed).toHaveBeenCalled()
+  unsubscribe(); await provider.dispose()
+})
