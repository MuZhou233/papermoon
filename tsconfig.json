{
  "compilerOptions": {
    "target": "ES2024",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "paths": {
      "@papermoon/story-storage": [
        "./plugins/story-storage/src/index.ts"
      ],
      "@papermoon/story-storage/value": [
        "./plugins/story-storage/src/value.ts"
      ],
      "@papermoon/story-core": [
        "./plugins/story-core/src/index.ts"
      ],
      "@papermoon/story-core/repository": [
        "./plugins/story-core/src/repository.ts"
      ],
      "@papermoon/ui": [
        "./packages/ui/src/index.ts"
      ]
    },
    "jsx": "react-jsx",
    "lib": [
      "ES2024",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "tooling/**/*.ts",
    "plugins/*/src/**/*.ts",
    "plugins/*/tests/**/*.ts",
    "vitest.config.ts",
    "plugins/*/src/**/*.tsx",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/tests/**/*.ts",
    "plugins/*/tests/**/*.tsx"
  ],
  "exclude": [
    "dsh",
    "node_modules"
  ]
}
