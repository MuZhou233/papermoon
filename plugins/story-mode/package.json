{
  "name": "@papermoon/story-mode",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-client-ui-trajectory",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@papermoon/ui-guidance",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@papermoon/playbook-editor"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@papermoon/ui": "workspace:*",
    "zod": "4.1.5",
    "@papermoon/playbook-compiler": "workspace:*",
    "@papermoon/writers": "workspace:*"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "description": "Create a Playbook story save and follow its chapter guidance.",
  "icon": "./icon.svg"
}
